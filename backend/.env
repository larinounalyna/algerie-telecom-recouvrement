# Copy to `.env` and fill in your real values.
# Mot de passe demandé pour SUPPRIMER un versement (Après Gaïa). Vide = suppression désactivée.
DELETE_VERSEMENT_PASSWORD=20262026

# Taux de TVA en % (incluse dans les montants TTC)
TVA_RATE=19
# Copy to `.env` and fill in your real values.

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=postgres

# Or set the full URL directly (overrides the fields above if present):
# DATABASE_URL=postgresql+psycopg://postgres:changeme@localhost:5432/at_recouvrement

CORS_ORIGINS=http://localhost:5173
ENV=development
